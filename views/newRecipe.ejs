<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <title>Share Your Recipe</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Shizuru&display=swap" rel="stylesheet" />
        <link rel="stylesheet" href="/styles/main.css" />
    </head>

    <body>

        <h1>Share Your Recipe</h1>

        <form class="recipe-form" action="/submit" method="POST">
            <label for="recipe_name">Recipe Name:</label>
            <input type="text" name="recipe_name" required />
            <label for="your_name">Your Name:</label>
            <input type="text" name="your_name" required />
            <label for="cook_time">Cook Time:</label>
            <input type="text" name="cook_time" required />
            <label for="serving_size">Servings:</label>
            <input type="text" name="serving_size" required />

            <label for="category">Meal Category:</label>
            <select name="category" required>
                <option value="breakfast">Breakfast</option>
                <option value="lunch">Lunch</option>
                <option value="dinner">Dinner</option>
                <option value="snack">Snack</option>
                <option value="dessert">Dessert</option>
                <option value="drinks">Drinks</option>
            </select>

            <label for="ingredients">Ingredients:</label>
            <textarea name="ingredients" required></textarea>
            <label for="steps">Steps:</label>
            <textarea name="steps" required></textarea>
            <input type="submit" value="Post" />
        </form>

    </body>
</html>